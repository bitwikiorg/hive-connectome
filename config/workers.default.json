{
  "version": 2,
  "workers": [
    {
      "id": "scout",
      "name": "Scout",
      "larva": {
        "engine": "synthetic",
        "state_size": 16,
        "substrate": "c_elegans",
        "config": {}
      },
      "bee": {
        "engine": "synthetic",
        "state_size": 64,
        "substrate": "drosophila",
        "config": {}
      },
      "description": "Generic on-demand classifier.",
      "role": "Classify one event and decide what to do with it.",
      "experiment": {
        "kind": "manual",
        "objective": "Determine whether the input matters and how it should be routed.",
        "task_prompt": "Classify the supplied event. Separate evidence from inference. Return what changed, relevance, route, and unresolved questions.",
        "expected_output": "meaningful/novelty/route labels",
        "eval_metric": "route accuracy + calibration",
        "notes": ""
      },
      "data_environment": {
        "mode": "manual",
        "source_ids": [],
        "poll_interval_seconds": 60,
        "always_on": false,
        "browser_extract": "dom",
        "ocr_enabled": false,
        "upstream_workers": []
      },
      "jev": {
        "enabled": true,
        "provider": "venice",
        "model": "jev-latest",
        "feedback_to_brain": true,
        "questions": {
          "meaningful_signal": {
            "type": "noul",
            "instructions": "Is this event materially meaningful to this experiment?"
          },
          "novelty": {
            "type": "score",
            "instructions": "How novel is this event relative to the worker's recurrent state?",
            "criteria": [
              "routine",
              "notable",
              "highly novel"
            ]
          },
          "route": {
            "type": "choice",
            "instructions": "What should this worker do next?",
            "criteria": {
              "store": "store evidence",
              "inspect": "inspect deeper",
              "escalate": "requires open-ended reasoning",
              "ignore": "no useful change"
            }
          },
          "llm_needed": {
            "type": "noul",
            "instructions": "Does this experiment need open-ended language reasoning for this event?"
          }
        },
        "llm_gate_threshold": 0.65
      },
      "llm": {
        "enabled": false,
        "provider": "lmstudio",
        "model": null,
        "activation": "jev_gate",
        "prompt": "Explain the event only when bounded classification is insufficient. Use evidence only.",
        "temperature": 0.2,
        "verify_with_jev": true
      },
      "runtime": {
        "mode": "on_demand",
        "interval_seconds": 60,
        "cron": null,
        "persist_brain_state": true,
        "max_events_per_tick": 25,
        "enabled": false
      },
      "outputs": {
        "save_event": true,
        "save_run": true,
        "write_labels": true,
        "emit_to_hivemind": false,
        "next_workers": []
      }
    },
    {
