    {
      "id": "primary-full",
      "name": "Primary Full Connectome",
      "larva": {
        "engine": "cook2019_connectome",
        "state_size": 300,
        "substrate": "c_elegans_cook_2019_corrected_2020",
        "config": {
          "pack_id": "worm-cook-2020",
          "file": "cook_2020_adjacency.xlsx",
          "substeps": 8
        }
      },
      "bee": {
        "engine": "malecns_full_v1",
        "enabled": true,
        "state_size": 166700,
        "substrate": "drosophila_malecns_v1_full",
        "config": {
          "pack_id": "fly-malecns-v1",
          "expected_neurons": 166700,
          "expected_directed_connections": 25582938,
          "expected_synapses": 124177617,
          "substeps": 5,
          "sample_size": 2048,
          "dt": 0.02,
          "tau": 0.1,
          "gain": 3,
          "tonic": 0.14,
          "threshold": 1
        }
      },
      "description": "PRIMARY CANDIDATE: full corrected Cook C. elegans → full MaleCNS v1.0. Requires the ~1.1 GB MaleCNS pack and a successful full-graph execution receipt.",
      "role": "Run the canonical full-connectome HIVE experiment without substituting reduced graphs.",
      "experiment": {
        "kind": "manual",
        "objective": "Measure what full Cook C. elegans → full MaleCNS contributes under controlled JEV/LLM ablations.",
        "task_prompt": "Process the supplied event through the configured full biological substrates. Separate measured neural state, engineered adapters, typed decisions, and language-model inference.",
        "expected_output": "full-connectome stage telemetry + bridge trace + decisions + optional reasoning",
        "eval_metric": "matched ablation performance, calibration, stability, latency, and null/shuffle controls",
        "notes": "Primary HIVE study. No reduced MaleCNS graph may satisfy this Core."
      },
      "data_environment": {
        "mode": "manual",
        "source_ids": [],
        "poll_interval_seconds": 60,
        "always_on": false,
        "browser_extract": "dom",
        "ocr_enabled": false,
        "upstream_workers": []
      },
      "jev": {
        "enabled": true,
        "provider": "venice",
        "model": "jev-latest",
        "feedback_to_brain": true,
        "questions": {
          "meaningful_signal": {
            "type": "noul",
            "instructions": "Is this event materially meaningful to this experiment?"
          },
          "novelty": {
            "type": "score",
            "instructions": "How novel is this event relative to the worker's recurrent state?",
            "criteria": [
              "routine",
              "notable",
              "highly novel"
            ]
          },
          "route": {
            "type": "choice",
            "instructions": "What should this worker do next?",
            "criteria": {
              "store": "store evidence",
              "inspect": "inspect deeper",
              "escalate": "requires open-ended reasoning",
              "ignore": "no useful change"
            }
          },
          "llm_needed": {
            "type": "noul",
            "instructions": "Does this experiment need open-ended language reasoning for this event?"
          }
        }
      },
      "llm": {
        "enabled": false,
        "provider": "venice",
        "model": null,
        "prompt": "Explain the event only when bounded classification is insufficient. Use evidence only.",
        "temperature": 0.2,
        "verify_with_jev": true,
        "feedback_to_brain": true,
        "feedback_targets": []
      },
      "runtime": {
        "mode": "on_demand",
        "interval_seconds": 60,
        "cron": null,
        "persist_brain_state": true,
        "max_events_per_tick": 25,
        "enabled": false,
        "integration_cycles": 2,
        "harness_passes": 2
      },
      "outputs": {
        "save_event": true,
        "save_run": true,
        "write_labels": true,
        "emit_to_hivemind": false,
        "next_workers": [],
        "recording_level": "trace"
      },
      "architecture": "worm,worm-to-fly,fly,readout,jev,llm,jev_verify,feedback"
    },
