{
  "id": "onchain",
  "description": "On-chain ecosystem profile for continuous state capture and data navigation.",
  "sources": [
    "rpc",
    "account-read",
    "contracts",
    "pools",
    "domain-data",
    "ecosystem-services"
  ],
  "effectors": [
    "labels",
    "state",
    "indexes",
    "action_proposals"
  ],
  "default_permissions": [
    "read",
    "label",
    "state_write",
    "propose"
  ],
  "wallet_signing": false,
  "execution_boundary": "separate-policy-and-signer-service"
}
