{
  "id": "workspace",
  "description": "Local-first workspace profile with explicit source opt-in.",
  "sources": [
    "local-inbox",
    "conversation-export",
    "repo-index",
    "notes"
  ],
  "effectors": [
    "labels",
    "state",
    "mcp-read"
  ],
  "default_permissions": [
    "read",
    "label",
    "state_write"
  ],
  "wallet_signing": false
}
